{
  "name": "ocoolto",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @ocoolto/api\" \"npm run dev -w @ocoolto/web\"",
    "build": "npm run build -w @ocoolto/web",
    "preview": "npm run build && npm run dev -w @ocoolto/api",
    "test": "npm test -w @ocoolto/api",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "prettier": "^3.10.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true
  },
  "packageManager": "npm@11.21.2",
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  }
}
