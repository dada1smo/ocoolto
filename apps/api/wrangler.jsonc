{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ocoolto",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // React build; /api/* goes to the Worker, everything else is the SPA
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    // database_id is filled in phase 5 (wrangler d1 create ocoolto); local dev ignores it
    { "binding": "DB", "database_name": "ocoolto", "database_id": "local" }
  ],
  "ratelimits": [
    // per-IP limit on endpoints that send email: 5 per minute
    { "name": "IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "EMAIL_FROM": "ocoolto <nao-responda@ocoolto.com>",
    "GLOBAL_EMAIL_LIMIT": "90"
  }
  // .dev.vars sets ENV=dev locally (magic link goes to the console) and Cloudflare's test Turnstile secret
  // secrets in production: RESEND_API_KEY, TURNSTILE_SECRET
}
